# ============================================================
# App Mode: 'local' | 'cloud' | 'all' (default: all)
#   local  — @mention chat only (no monitors, no daily summary)
#   cloud  — monitors + daily summary + mentions in monitor threads only
#   all    — everything enabled
# ============================================================
# APP_MODE=all

# ============================================================
# System
# ============================================================
# Bot Token (starts with xoxb-)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token (starts with xapp-, requires connections:write scope)
# SLACK_APP_TOKEN=xapp-your-app-token
# Personal Slack tokens (for reading channel history, posting as yourself)
# SLACK_XOXC_TOKEN=xoxc-your-token
# SLACK_XOXD_TOKEN=xoxd-your-token
# Channel ID to send notifications to
# SLACK_CHANNEL_ID=C0123456789
# Owner user ID (only this user can interact with the bot)
# SLACK_OWNER_USER_ID=U0123456789
# Claude working directory
# SLACK_REPO_PATH=/Users/you/your-project
# Root directory for project discovery ("start claude in project XXX from root")
# SLACK_REPO_ROOT=/Users/you/projects
# Custom Claude launch command (optional)
# SLACK_CLAUDE_COMMAND=claude --dangerously-skip-permissions
# Pin the bot's spawned Claude sessions to a specific model — useful when
# your interactive Claude config defaults to Opus-with-xhigh-effort, which
# tends to be flaky at calling MCP tools (sometimes "thinks" and refuses
# to invoke `mcp__slack-ask__ask_user`). Anything matching [A-Za-z0-9._-]+
# is accepted; anything else is silently dropped. Doesn't affect your
# interactive Claude.
# SLACK_CLAUDE_MODEL=claude-sonnet-4-6
# Authorized user whitelist (comma-separated Slack User IDs). Additive with
# SLACK_ALLOWED_SUBTEAMS. Empty = no per-user entries.
# SLACK_WHITELIST=U0123456789,U9876543210
# Allowed subteams (comma-separated Slack usergroup IDs, e.g. Sxxxxxxxx). When
# SLACK_WHITELIST or SLACK_ALLOWED_SUBTEAMS is set, @mention access is locked
# down: only the owner and these members may talk to the bot. Members get
# RESTRICTED sessions (the bot refuses to reveal personal / server info);
# only SLACK_OWNER_USER_ID gets full access. Empty = open to everyone.
# Requires the `usergroups:read` bot scope. Find IDs via usergroups.list.
# SLACK_ALLOWED_SUBTEAMS=S01TMG8Q65R,S09JHFPD0GJ
# Write-authorized subteams (comma-separated usergroup IDs). Members may direct
# the bot to perform repo WRITE actions — PR approve/merge, push, commit — under
# the bot's git/GitHub identity. Should be a subset of SLACK_ALLOWED_SUBTEAMS.
# The disclosure boundary (personal/server info) still applies to non-owners.
# Empty = only SLACK_OWNER_USER_ID can trigger writes.
# SLACK_WRITE_SUBTEAMS=S01TMG8Q65R
# PagerDuty API authentication (for auto-acknowledge)
# PAGERDUTY_API_TOKEN=your-pagerduty-api-token
# PAGERDUTY_FROM_EMAIL=your-email@company.com
# PD email → Slack user ID map for the L1 "double-check" ping after alert
# investigation reports. Format: "email1:slack_user_id1,email2:slack_user_id2,..."
# Update when team membership changes; restart the service to pick up.
# PD_EMAIL_SLACK_MAP=
LOG_LEVEL=info
# Daily auto-restart hour (0-23, local time, empty to disable)
# DAILY_RESTART_HOUR=23
# HTTP API port (default: 9999, Swagger UI: http://localhost:9999/docs)
# SLACK_HTTP_PORT=9999

# ============================================================
# Daily Summary
# ============================================================
# Channels to summarize (format: name:ID,name:ID)
# DAILY_SUMMARY_CHANNELS=general:C012345,engineering:C067890
# Time to run (HH:MM format, local time, default: 07:00)
# DAILY_SUMMARY_TIME=07:00
# Claude model (sonnet, opus, haiku — default: sonnet)
# DAILY_SUMMARY_MODEL=sonnet

# ============================================================
# Monitor Channels (PagerDuty Alerts)
# ============================================================
# Channels to watch (comma-separated names, prefix ! to exclude)
# MONITOR_CHANNELS=payments-alerts
# Claude skill for alert investigation
# ALERT_SKILL=one:pay-ops-production
# CLI chain to drive PagerDuty alert investigations.
# Accepts a single CLI name (e.g. `claude`) or a CSV fallback chain (e.g.
# `codex,claude` → try Codex first, fall back to Claude on fatal startup
# errors like quota exhaustion). Default: claude.
# ALERT_CLI=codex,claude
# How long the poller waits (idle, no output change) before timing out (ms, default: 1800000 = 30min)
# POLLER_TIMEOUT_MS=1800000
# Hard wall-clock ceiling for a single poll (ms, default: 0 → POLLER_TIMEOUT_MS*4 = 2h)
# POLLER_MAX_WALL_MS=0
# Busy-loop escalation: for alert investigations, if the CLI's pane content (minus
# the spinner/timer/context chrome) hasn't changed for this long while the spinner
# is still up, give up and escalate to the next CLI in the chain. Must comfortably
# exceed the longest legitimate silent tool call (e.g. a multi-minute Athena query).
# (ms, default: 360000 = 6min)
# POLLER_NO_PROGRESS_MS=360000
# Max concurrent alert investigations (default: 1 — process alerts sequentially)
# ALERT_MAX_CONCURRENT=1
# Max nudge retries before posting "incomplete" warning (default: 3)
# HOOK_MAX_RETRIES=3

# ============================================================
# Monitor Delay Channels (Airflow Alerts)
# ============================================================
# Channels to watch for Airflow task delay alerts
# MONITOR_DELAY_CHANNELS=task-alerts-production
# Task name patterns to match (comma-separated, case-insensitive)
# DELAY_ALERT_TASK_PATTERNS=process-taxes
# Number of alerts before triggering investigation (default: 3)
# DELAY_ALERT_THRESHOLD=3
# Time window for counting alerts (ms, default: 3600000 = 1hr)
# DELAY_ALERT_WINDOW_MS=3600000
# Claude skill for delay investigation
# DELAY_ALERT_SKILL=one:pay-ops-tax-production
# CLI chain to drive Airflow delay investigations.
# Same semantics as ALERT_CLI — single CLI or CSV fallback chain. Default: claude.
# DELAY_ALERT_CLI=codex,claude

# ============================================================
# MCP `slack-ask` server — interactive questions over Slack
# See docs/mcp-ask-user.md for the design.
# ============================================================
# Master switch — must be true to start the MCP HTTP server.
# MCP_ENABLED=false
# Bind host/port for the MCP HTTP server (loopback recommended)
# MCP_BIND_HOST=127.0.0.1
# MCP_PORT=9998
# Default per-question timeout in ms before the tool resolves with
# {status: "timeout"}. Default: 1800000 (30 min).
# MCP_DEFAULT_TIMEOUT_MS=1800000

# ============================================================
# Gemini CLI Configuration
# ============================================================
# Gemini sessions automatically register the `slack-ask` MCP server
# when MCP_ENABLED=true. It updates ~/.gemini/settings.json idempotently.

# OpenRouter (default backend for the 3 socket.js calls: file describe, thread
# summary, project-path detection). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional; defaults to google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# LLM provider toggle. 'openrouter' (default) uses OPENROUTER_API_KEY above.
# Set to 'google' to fail over to the direct Gemini API (e.g. OpenRouter out of
# quota): fill GOOGLE_API_KEY with an AIza… key, set LLM_PROVIDER=google, then
# `npm run restart`. GOOGLE_MODEL is optional (defaults to gemini-2.5-flash).
LLM_PROVIDER=openrouter
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ============================================================
# Codex CLI Configuration
# ============================================================
# Codex sessions automatically register the `slack-ask` MCP server
# when MCP_ENABLED=true by passing a session-specific streamable HTTP
# MCP URL via Codex's per-launch `-c mcp_servers.slackask.url=...`.

# ============================================================
# SSO Pre-Warm
# ============================================================
# Keeps the local SSO credential server's AWS token hot so PD investigations
# never pay the ~60-90s puppeteer-login cost mid-incident. Only runs on
# instances that handle alerts (APP_MODE=cloud|all). Failures DM the owner.
# Enable the watcher
# SSO_PREWARM_ENABLED=true
# Credential server URL (default: http://localhost:6789)
# SSO_PREWARM_URL=http://localhost:6789
# CSV of AWS profiles to keep warm — single profile today, multiple later:
#   SSO_PREWARM_PROFILES=payments_us_production
#   SSO_PREWARM_PROFILES=payments_us_production,payments_staging
# SSO_PREWARM_PROFILES=payments_us_production
# Poll interval (ms, default: 1800000 = 30 min). Must be < SSO session lifetime.
# SSO_PREWARM_INTERVAL_MS=1800000
# Per-call timeout (ms, default: 120000 = 2 min). Generous on purpose:
# `serve-credentials.sh` is socat-serialised and shells out to `aws` per
# request, so legitimate cached `/credentials` responses are measured at
# 20-40s. A tighter timeout would alert false-positive. Revisit if the
# upstream `wego-infra/sso` server is ever optimised.
# SSO_PREWARM_TIMEOUT_MS=120000

# --- BigQuery auth health monitor ---
# The bot runs `bq` queries during investigations using the host gcloud user
# credential. That refresh token expires periodically; every `bq` call then
# fails with "Reauthentication failed ... run gcloud auth login". Unlike SSO
# there is NO auto-recovery (gcloud login is interactive), so this watcher only
# DETECTS the expiry and DMs the owner to refresh — instead of it silently
# surfacing mid-incident. Runs on cloud/all instances only.
# Enable the watcher
# BQ_HEALTH_ENABLED=true
# Override the bq binary/wrapper (default: bq on PATH)
# BQ_HEALTH_COMMAND=bq
# Interim: point at the ADC shim so bq auth uses Application Default Credentials
# (long-lived) instead of the gcloud CLI login (org reauth expires it ~daily).
# Install: sudo install -m0755 scripts/bq-adc-shim.sh /usr/local/bin/bq
# Then set: BQ_HEALTH_COMMAND=/usr/local/bin/bq
# Remove once a service-account key (claude-bigquery-viewer) is installed.
# Poll interval (ms, default: 1800000 = 30 min)
# BQ_HEALTH_INTERVAL_MS=1800000
# Per-check timeout (ms, default: 60000 = 1 min)
# BQ_HEALTH_TIMEOUT_MS=60000

# --- Google Workspace (gws) auth health monitor ---
# Gmail/Docs/Sheets/Drive access runs through the `gws` CLI, which uses its own
# long-lived OAuth token in ~/.config/gws (separate from gcloud/ADC and AWS).
# When it expires the fix is an interactive `gws auth login`, so this only
# DETECTS the expiry and DMs the owner. Probe: `gws drive about get`. cloud/all
# instances only.
# BQ_HEALTH-style knobs:
# GWS_HEALTH_ENABLED=true
# GWS_HEALTH_COMMAND=gws
# GWS_HEALTH_INTERVAL_MS=1800000
# GWS_HEALTH_TIMEOUT_MS=30000

# ============================================================
# Entity Plan H: PR review board
# ============================================================
# Enable Slack PR detection, GitHub state monitoring, and the App Home board.
# PR_BOARD_ENABLED=false
# GitHub token used only for read-only PR/CI monitoring.
# GITHUB_TOKEN=
# Refresh interval in minutes.
# PR_MONITOR_INTERVAL_MIN=15
# Auto-run apex-review when a tracked PR becomes review-ready. The result is
# still draft-only; posting always requires tapping Post.
# PR_AUTO_REVIEW=false

# ============================================================
# Entity Plan D: Mac runner queue
# ============================================================
# Shared secret between the /runner/* endpoints and the Mac runner daemon.
# Generate with: openssl rand -hex 24
# Endpoints fail closed while this is unset — every request is rejected.
# RUNNER_TOKEN=
