# ============================================================
# App Mode: 'local' | 'cloud' | 'all' (default: all)
#   local  — @mention chat only (no monitors, no daily summary)
#   cloud  — monitors + daily summary + mentions in monitor threads only
#   all    — everything enabled
# ============================================================
# APP_MODE=all

# ============================================================
# System
# ============================================================
# Bot Token (starts with xoxb-)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token (starts with xapp-, requires connections:write scope)
# SLACK_APP_TOKEN=xapp-your-app-token
# Personal Slack tokens (for reading channel history, posting as yourself)
# SLACK_XOXC_TOKEN=xoxc-your-token
# SLACK_XOXD_TOKEN=xoxd-your-token
# Channel ID to send notifications to
# SLACK_CHANNEL_ID=C0123456789
# Owner user ID (only this user can interact with the bot)
# SLACK_OWNER_USER_ID=U0123456789
# Claude working directory
# SLACK_REPO_PATH=/Users/you/your-project
# Root directory for project discovery ("start claude in project XXX from root")
# SLACK_REPO_ROOT=/Users/you/projects
# Custom Claude launch command (optional)
# SLACK_CLAUDE_COMMAND=claude --dangerously-skip-permissions
# Authorized user whitelist (comma-separated Slack User IDs, empty = all allowed)
# SLACK_WHITELIST=U0123456789,U9876543210
# PagerDuty API authentication (for auto-acknowledge)
# PAGERDUTY_API_TOKEN=your-pagerduty-api-token
# PAGERDUTY_FROM_EMAIL=your-email@company.com
# PD email → Slack user ID map for the L1 "double-check" ping after alert
# investigation reports. Format: "email1:slack_user_id1,email2:slack_user_id2,..."
# Update when team membership changes; restart the service to pick up.
# PD_EMAIL_SLACK_MAP=
LOG_LEVEL=info
# Daily auto-restart hour (0-23, local time, empty to disable)
# DAILY_RESTART_HOUR=23
# HTTP API port (default: 9999, Swagger UI: http://localhost:9999/docs)
# SLACK_HTTP_PORT=9999

# ============================================================
# Daily Summary
# ============================================================
# Channels to summarize (format: name:ID,name:ID)
# DAILY_SUMMARY_CHANNELS=general:C012345,engineering:C067890
# Time to run (HH:MM format, local time, default: 07:00)
# DAILY_SUMMARY_TIME=07:00
# Claude model (sonnet, opus, haiku — default: sonnet)
# DAILY_SUMMARY_MODEL=sonnet

# ============================================================
# Monitor Channels (PagerDuty Alerts)
# ============================================================
# Channels to watch (comma-separated names, prefix ! to exclude)
# MONITOR_CHANNELS=payments-alerts
# Claude skill for alert investigation
# ALERT_SKILL=one:pay-ops-production
# CLI chain to drive PagerDuty alert investigations.
# Accepts a single CLI name (e.g. `claude`) or a CSV fallback chain (e.g.
# `codex,claude` → try Codex first, fall back to Claude on fatal startup
# errors like quota exhaustion). Default: claude.
# ALERT_CLI=codex,claude
# How long the poller waits for Claude response before timing out (ms, default: 1800000 = 30min)
# POLLER_TIMEOUT_MS=1800000
# Max concurrent alert investigations (default: 1 — process alerts sequentially)
# ALERT_MAX_CONCURRENT=1
# Max nudge retries before posting "incomplete" warning (default: 3)
# HOOK_MAX_RETRIES=3

# ============================================================
# Monitor Delay Channels (Airflow Alerts)
# ============================================================
# Channels to watch for Airflow task delay alerts
# MONITOR_DELAY_CHANNELS=task-alerts-production
# Task name patterns to match (comma-separated, case-insensitive)
# DELAY_ALERT_TASK_PATTERNS=process-taxes
# Number of alerts before triggering investigation (default: 3)
# DELAY_ALERT_THRESHOLD=3
# Time window for counting alerts (ms, default: 3600000 = 1hr)
# DELAY_ALERT_WINDOW_MS=3600000
# Claude skill for delay investigation
# DELAY_ALERT_SKILL=one:pay-ops-tax-production
# CLI chain to drive Airflow delay investigations.
# Same semantics as ALERT_CLI — single CLI or CSV fallback chain. Default: claude.
# DELAY_ALERT_CLI=codex,claude

# ============================================================
# MCP `slack-ask` server — interactive questions over Slack
# (Scaffold only in this branch; nothing wires in until Phase 2.)
# See docs/mcp-ask-user.md for the design.
# ============================================================
# Master switch — must be true to start the MCP HTTP server.
# MCP_ENABLED=false
# Bind host/port for the MCP HTTP server (loopback recommended)
# MCP_BIND_HOST=127.0.0.1
# MCP_PORT=9998
# Default per-question timeout in ms before the tool resolves with
# {status: "timeout"}. Default: 1800000 (30 min).
# MCP_DEFAULT_TIMEOUT_MS=1800000

# ============================================================
# SSO Pre-Warm
# ============================================================
# Keeps the local SSO credential server's AWS token hot so PD investigations
# never pay the ~60-90s puppeteer-login cost mid-incident. Only runs on
# instances that handle alerts (APP_MODE=cloud|all). Failures DM the owner.
# Enable the watcher
# SSO_PREWARM_ENABLED=true
# Credential server URL (default: http://localhost:6789)
# SSO_PREWARM_URL=http://localhost:6789
# CSV of AWS profiles to keep warm — single profile today, multiple later:
#   SSO_PREWARM_PROFILES=payments_us_production
#   SSO_PREWARM_PROFILES=payments_us_production,payments_staging
# SSO_PREWARM_PROFILES=payments_us_production
# Poll interval (ms, default: 1800000 = 30 min). Must be < SSO session lifetime.
# SSO_PREWARM_INTERVAL_MS=1800000
# Per-call timeout (ms, default: 120000 = 2 min). Covers worst-case puppeteer login.
# SSO_PREWARM_TIMEOUT_MS=120000
